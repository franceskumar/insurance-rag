# The default works offline: retrieve and quote relevant source passages.
ANSWER_PROVIDER=extractive

# For local LLM answers: install Ollama, pull a model, then select ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# For OpenAI answers: select openai and supply your own key and model ID.
# Retrieved policy excerpts and your question are sent to OpenAI in this mode.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional. Defaults to ./data/policylens.sqlite3.
# INSURANCE_DB=/absolute/path/to/policylens.sqlite3
